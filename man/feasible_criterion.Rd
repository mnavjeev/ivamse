y <- 2 * x + 0.7 * v + rnorm(N)
m <- ivamse_fit(y, x, z)

cand <- m$candidates
by_hand <- feasible_criterion(cand$fitted_moment, cand$d, cand$h,
                              m$sigma_eps2, m$sigma_epsv, m$n)
all.equal(by_hand, cand$criterion)
