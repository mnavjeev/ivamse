v <- rnorm(N)
x <- as.vector(z[, 1] + 0.5 * z[, 2] + w + v)
y <- as.vector(2 * x + w + 0.7 * v + rnorm(N))

## the default: a grid of 25 penalties, chosen by the criterion
m <- ivamse_fit(y, x, z, w = w)
